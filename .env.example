# Copie para .env e preencha. NUNCA suba o .env para o GitHub.

# LLM (API compatível com OpenAI). Groq na nuvem; LLM_MODEL aceita lista: principal,reserva
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=coloque_sua_chave_groq_aqui
LLM_MODEL=qwen/qwen3.8-27b,openai/gpt-oss-20b
# ...ou Ollama local (arquitetura original da CP4), sem chave:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b   (ou llama3.2:3b)

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=chave_service_role_SO_NO_SERVIDOR
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=chave_anon_publica
# LLM_TIMEOUT=120
